generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Live menu (storefront reads this directly; admin edits in place).
model Menu {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?
  price        Decimal           @db.Decimal(10, 2)
  image        String?
  isFavorite   Boolean           @default(false)
  available    Boolean           @default(true)
  /// Max total quantity that can be sold (all-time). Null = unlimited.
  maxQuantity  Int?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
}

model MenuOptionGroup {
  id          String       @id @default(cuid())
  menuId      String
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  sortOrder   Int          @default(0)
  name        String
  required    Boolean      @default(false)
  multiSelect Boolean      @default(false)
  options     MenuOption[]
}

model MenuOption {
  id         String          @id @default(cuid())
  groupId    String
  group      MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)
  label      String
  priceDelta Decimal         @default(0) @db.Decimal(10, 2)
}

model Order {
  id           String       @id @default(cuid())
  slugId       String       @unique
  customerName String
  phone        String
  type         OrderType
  /// Full street address when type is DELIVERY.
  deliveryAddress String?
  /// Gate, unit, landmarks (optional) when type is DELIVERY.
  deliveryNotes   String?
  status       OrderStatus  @default(RECEIVED)
  batchId      String?
  batch        OrderBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  /// Checkout selection: pay at pickup vs online transfer + receipt.
  paymentChoice         PaymentChoice         @default(PAY_LATER)
  /// Set when PAY_NOW: URL to uploaded payment proof (same host as /uploads).
  paymentReceiptUrl     String?
  orderItems   OrderItem[]
  appFeedbacks AppFeedback[]
}

/// Optional post-checkout remarks about the storefront experience (linked to order when provided).
model AppFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
}

/// How the customer intends to pay (checkout modal).
enum PaymentChoice {
  PAY_LATER
  PAY_NOW
}

enum OrderBatchStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A time window when customers may order (live menu applies; capacity is per batch).
model OrderBatch {
  id              String           @id @default(cuid())
  label           String?
  fulfillmentDate DateTime         @db.Date
  opensAt         DateTime
  closesAt        DateTime
  maxItems        Int
  status          OrderBatchStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity          Int
  menuId            String
  menu              Menu     @relation(fields: [menuId], references: [id])
  remarks           String?
  unitPrice         Decimal  @db.Decimal(10, 2)
  selectedOptions   Json?
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  /// POS / admin UI display name (e.g. \"Ahmad\") — falls back to email if empty.
  displayName  String?
  createdAt    DateTime @default(now())

  posOrders         PosOrder[] @relation("CreatedByAdmin")
  posOrdersPaidBy   PosOrder[] @relation("PaidByAdmin")
  posPurchases      PosPurchase[]
}

// ─── Weekend Grills POS ───────────────────────────────────────────────────────

enum PosPaymentMethod {
  CASH
  QR
}

enum PosPaymentStatus {
  UNPAID
  PAID
  REFUNDED
  VOIDED
}

enum PosOrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PosProductType {
  COMBO
  VARIANT
  SIMPLE
}

enum PosOrderLineType {
  COMBO
  VARIANT
  SIMPLE
}

/// Top-level menu tabs (Combos, À la carte).
model PosMenuSection {
  id        String       @id @default(cuid())
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  PosProduct[]

  @@index([sortOrder])
}

model PosProduct {
  id          String         @id @default(cuid())
  sectionId   String
  section     PosMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        PosProductType
  name        String
  description String?
  image       String?
  basePrice   Decimal        @db.Decimal(10, 2)
  available   Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  combo       PosCombo?
  variants    PosProductVariant[]
  optionSlots PosProductOptionSlot[]
  orderItems          PosOrderItem[]
  productIngredients  PosProductIngredient[]

  @@index([sectionId, sortOrder])
}

/// Customizable choices for à la carte (SIMPLE) items — e.g. Spicy / Non-spicy.
model PosProductOptionSlot {
  id        String     @id @default(cuid())
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int        @default(0)
  required  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  options PosProductOptionSlotOption[]

  @@index([productId, sortOrder])
}

model PosProductOptionSlotOption {
  id         String               @id @default(cuid())
  slotId     String
  slot       PosProductOptionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal              @default(0) @db.Decimal(10, 2)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([slotId, sortOrder])
}

model PosProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal    @db.Decimal(10, 2)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orderItems PosOrderItem[]

  @@index([productId, sortOrder])
}

model PosCombo {
  id           String     @id @default(cuid())
  productId    String     @unique
  product      PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  includesText String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  slots PosComboSlot[]
}

model PosComboSlot {
  id        String   @id @default(cuid())
  comboId   String
  combo     PosCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PosComboSlotOption[]

  @@index([comboId, sortOrder])
}

model PosComboSlotOption {
  id         String       @id @default(cuid())
  slotId     String
  slot       PosComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([slotId, sortOrder])
}

model PosOrder {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerName    String
  status          PosOrderStatus   @default(PLACED)
  paymentMethod   PosPaymentMethod
  paymentStatus   PosPaymentStatus @default(UNPAID)
  subtotal        Decimal          @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  notes           String?

  createdByAdminId String?
  createdBy        Admin?  @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  paidByAdminId String?
  paidBy        Admin?  @relation("PaidByAdmin", fields: [paidByAdminId], references: [id], onDelete: SetNull)

  paidAt      DateTime?
  startedAt   DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  /// Set when countable inventory was deducted at Start Cooking (PLACED → PREPARING).
  inventoryDeductedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems           PosOrderItem[]
  inventoryMovements   PosInventoryMovement[]

  @@index([status])
  @@index([createdAt])
}

model PosOrderItem {
  id              String            @id @default(cuid())
  orderId         String
  order           PosOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineType        PosOrderLineType
  productId       String?
  product         PosProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         PosProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  displayName     String
  choicesSummary  String?
  choicesJson     Json?
  quantity        Int
  unitPrice       Decimal           @db.Decimal(10, 2)
  remarks         String?

  @@index([productId])
  @@index([orderId])
}

// ─── Inventory (countable stock deducted when kitchen starts cooking) ────────

model PosInventoryItem {
  id                String   @id @default(cuid())
  name              String   @unique
  unit              String?
  /// When false, linked to recipes for reference only (sauce, fries) — no stock deduction.
  isCountable       Boolean  @default(true)
  quantityOnHand    Decimal  @default(0) @db.Decimal(10, 2)
  lowStockThreshold Decimal? @db.Decimal(10, 2)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productLinks PosProductIngredient[]
  movements    PosInventoryMovement[]

  @@index([sortOrder])
}

model PosProductIngredient {
  id              String           @id @default(cuid())
  productId       String
  product         PosProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   PosInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  /// Amount consumed per 1 unit of this menu item (e.g. 1 chicken leg per BBQ set).
  quantityPerUnit Decimal          @db.Decimal(10, 2)

  @@unique([productId, inventoryItemId])
  @@index([inventoryItemId])
}

model PosInventoryMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  inventoryItem   PosInventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  orderId         String?
  order           PosOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  delta           Decimal           @db.Decimal(10, 2)
  reason          String
  createdAt       DateTime          @default(now())

  @@index([orderId])
  @@index([inventoryItemId, createdAt])
}

// ─── Purchases ledger ────────────────────────────────────────────────────────

model PosPurchase {
  id               String   @id @default(cuid())
  remark           String
  amount           Decimal  @db.Decimal(10, 2)
  purchasedAt      DateTime @default(now())
  createdByAdminId String?
  createdBy        Admin?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([purchasedAt])
}

model SystemSettings {
  id                      String   @id @default(cuid())
  maxOrdersPerDay         Int      @default(15)
  orderingEnabled         Boolean  @default(true)
  minimumDeliveryAmount   Decimal? @db.Decimal(10, 2)
  /// Admin storefront display name (sidebar, optional public use).
  companyName             String?
  /// URL from POST /uploads/image (admin).
  companyLogoUrl          String?
  /// Payment transfer QR shown at checkout (uploaded image / SVG URL).
  paymentQrUrl            String?
  /// WhatsApp number for admin new-order alerts (E.164 e.g. +60123456789). Overrides .env fallback.
  adminWhatsappNumber     String?
  updatedAt               DateTime @updatedAt
}
