generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Live menu (storefront reads this directly; admin edits in place).
model Menu {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?
  price        Decimal           @db.Decimal(10, 2)
  image        String?
  isFavorite   Boolean           @default(false)
  available    Boolean           @default(true)
  /// Lightweight grouping for the storefront menu (e.g. "Buns", "Sides", "Drinks"). Null = uncategorised.
  category     String?
  /// Manual admin "sold out" toggle. The storefront also derives sold-out from maxQuantity.
  soldOut      Boolean           @default(false)
  /// Max total quantity that can be sold (all-time). Null = unlimited.
  maxQuantity  Int?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
}

model MenuOptionGroup {
  id          String       @id @default(cuid())
  menuId      String
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  sortOrder   Int          @default(0)
  name        String
  required    Boolean      @default(false)
  multiSelect Boolean      @default(false)
  options     MenuOption[]
}

model MenuOption {
  id         String          @id @default(cuid())
  groupId    String
  group      MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)
  label      String
  priceDelta Decimal         @default(0) @db.Decimal(10, 2)
}

model Order {
  id                String        @id @default(cuid())
  slugId            String        @unique
  customerName      String
  phone             String
  type              OrderType
  /// Full street address when type is DELIVERY.
  deliveryAddress   String?
  /// Gate, unit, landmarks (optional) when type is DELIVERY.
  deliveryNotes     String?
  status            OrderStatus   @default(RECEIVED)
  /// Set when status becomes CANCELLED.
  cancelledAt       DateTime?
  batchId           String?
  batch             OrderBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  /// Free-text "Comments for the restaurant" captured on the confirm screen.
  restaurantComment String?
  /// Persisted money breakdown (null on legacy orders predating the revamp; compute from line items).
  subtotal          Decimal?      @db.Decimal(10, 2)
  deliveryFee       Decimal?      @db.Decimal(10, 2)
  processingFee     Decimal?      @db.Decimal(10, 2)
  /// Tax portion already INCLUDED in `total` (SST, default 6%).
  taxAmount         Decimal?      @db.Decimal(10, 2)
  total             Decimal?      @db.Decimal(10, 2)
  /// Checkout selection: pay at pickup vs online transfer + receipt.
  paymentChoice     PaymentChoice @default(PAY_LATER)
  /// Set when PAY_NOW: URL to uploaded payment proof (same host as /uploads).
  paymentReceiptUrl String?
  /// The signed-in customer who placed it. Null for a guest order. Never sent to the public.
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  appFeedbacks      AppFeedback[]

  @@index([userId])
}

/// Optional post-checkout remarks about the storefront experience (linked to order when provided).
model AppFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  /// Delivery orders: en route to the customer.
  OUT_FOR_DELIVERY
  /// Pickup orders: collected by the customer.
  PICKED_UP
  /// Legacy delivery terminal state (kept for existing rows / notifications).
  DELIVERED
  /// Generic terminal "done" state used by the KDS board.
  COMPLETED
  CANCELLED
}

/// How the customer intends to pay (checkout modal).
enum PaymentChoice {
  PAY_LATER
  PAY_NOW
}

enum OrderBatchStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A time window when customers may order (live menu applies; capacity is per batch).
model OrderBatch {
  id              String           @id @default(cuid())
  label           String?
  fulfillmentDate DateTime         @db.Date
  opensAt         DateTime
  closesAt        DateTime
  maxItems        Int
  status          OrderBatchStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity        Int
  menuId          String
  menu            Menu    @relation(fields: [menuId], references: [id])
  remarks         String?
  unitPrice       Decimal @db.Decimal(10, 2)
  selectedOptions Json?
}

enum AdminRole {
  OWNER
  MANAGER
  KITCHEN
  CASHIER
}

/// DEPRECATED: replaced by `User` (Better Auth). Kept one release as a backup of staff
/// logins; nothing reads it. Drop in a later migration.
model Admin {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  /// POS / admin UI display name (e.g. \"Ahmad\") — falls back to email if empty.
  displayName String?
  /// Light RBAC: gates a few sensitive admin screens. Existing admins default to full access.
  role        AdminRole @default(OWNER)
  createdAt   DateTime  @default(now())
}

// ─── Better Auth (v1.7): staff and customers share these tables ───────────────

/// One row per person. Staff carry an AdminRole name in `role`; customers are "CUSTOMER".
/// Staff rows were copied from `Admin` with the same id.
model User {
  id            String   @id
  /// Better Auth's `name` field (mapped via user.fields.name).
  displayName   String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// CUSTOMER | OWNER | MANAGER | KITCHEN | CASHIER. Never settable from a request body.
  role          String   @default("CUSTOMER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  posOrders        PosOrder[]        @relation("CreatedByAdmin")
  posOrdersPaidBy  PosOrder[]        @relation("PaidByAdmin")
  posPurchases     PosPurchase[]
  cateringBookings CateringBooking[]
  shopOrders       ShopOrder[]
  orders           Order[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  /// "credential" for email + password; `password` then holds a bcrypt hash.
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Weekend Grills POS ───────────────────────────────────────────────────────

enum PosPaymentMethod {
  CASH
  QR
}

enum PosPaymentStatus {
  UNPAID
  PAID
  REFUNDED
  VOIDED
}

enum PosOrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PosProductType {
  COMBO
  VARIANT
  SIMPLE
}

enum PosOrderLineType {
  COMBO
  VARIANT
  SIMPLE
}

/// Top-level menu tabs (Combos, À la carte).
model PosMenuSection {
  id        String       @id @default(cuid())
  name      String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  PosProduct[]

  @@index([sortOrder])
}

model PosProduct {
  id          String         @id @default(cuid())
  sectionId   String
  section     PosMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        PosProductType
  name        String
  description String?
  image       String?
  basePrice   Decimal        @db.Decimal(10, 2)
  available   Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  combo              PosCombo?
  variants           PosProductVariant[]
  optionSlots        PosProductOptionSlot[]
  orderItems         PosOrderItem[]
  productIngredients PosProductIngredient[]

  @@index([sectionId, sortOrder])
}

/// Customizable choices for à la carte (SIMPLE) items — e.g. Spicy / Non-spicy.
model PosProductOptionSlot {
  id        String     @id @default(cuid())
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int        @default(0)
  required  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  options PosProductOptionSlotOption[]

  @@index([productId, sortOrder])
}

model PosProductOptionSlotOption {
  id         String               @id @default(cuid())
  slotId     String
  slot       PosProductOptionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal              @default(0) @db.Decimal(10, 2)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([slotId, sortOrder])
}

model PosProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal    @db.Decimal(10, 2)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  orderItems PosOrderItem[]

  @@index([productId, sortOrder])
}

model PosCombo {
  id           String     @id @default(cuid())
  productId    String     @unique
  product      PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  includesText String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  slots PosComboSlot[]
}

model PosComboSlot {
  id        String   @id @default(cuid())
  comboId   String
  combo     PosCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PosComboSlotOption[]

  @@index([comboId, sortOrder])
}

model PosComboSlotOption {
  id         String       @id @default(cuid())
  slotId     String
  slot       PosComboSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Decimal      @default(0) @db.Decimal(10, 2)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([slotId, sortOrder])
}

model PosOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique
  customerName  String
  status        PosOrderStatus   @default(PLACED)
  paymentMethod PosPaymentMethod
  paymentStatus PosPaymentStatus @default(UNPAID)
  subtotal      Decimal          @db.Decimal(10, 2)
  total         Decimal          @db.Decimal(10, 2)
  notes         String?

  createdByAdminId String?
  createdBy        User?   @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  paidByAdminId String?
  paidBy        User?   @relation("PaidByAdmin", fields: [paidByAdminId], references: [id], onDelete: SetNull)

  paidAt              DateTime?
  startedAt           DateTime?
  readyAt             DateTime?
  completedAt         DateTime?
  /// Set when countable inventory was deducted at Start Cooking (PLACED → PREPARING).
  inventoryDeductedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orderItems         PosOrderItem[]
  inventoryMovements PosInventoryMovement[]

  @@index([status])
  @@index([createdAt])
}

model PosOrderItem {
  id             String             @id @default(cuid())
  orderId        String
  order          PosOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineType       PosOrderLineType
  productId      String?
  product        PosProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId      String?
  variant        PosProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  displayName    String
  choicesSummary String?
  choicesJson    Json?
  quantity       Int
  unitPrice      Decimal            @db.Decimal(10, 2)
  remarks        String?

  @@index([productId])
  @@index([orderId])
}

// ─── Inventory (countable stock deducted when kitchen starts cooking) ────────

model PosInventoryItem {
  id                String   @id @default(cuid())
  name              String   @unique
  unit              String?
  /// When false, linked to recipes for reference only (sauce, fries) — no stock deduction.
  isCountable       Boolean  @default(true)
  quantityOnHand    Decimal  @default(0) @db.Decimal(10, 2)
  lowStockThreshold Decimal? @db.Decimal(10, 2)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productLinks PosProductIngredient[]
  movements    PosInventoryMovement[]

  @@index([sortOrder])
}

model PosProductIngredient {
  id              String           @id @default(cuid())
  productId       String
  product         PosProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   PosInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  /// Amount consumed per 1 unit of this menu item (e.g. 1 chicken leg per BBQ set).
  quantityPerUnit Decimal          @db.Decimal(10, 2)

  @@unique([productId, inventoryItemId])
  @@index([inventoryItemId])
}

model PosInventoryMovement {
  id              String           @id @default(cuid())
  inventoryItemId String
  inventoryItem   PosInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  orderId         String?
  order           PosOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  delta           Decimal          @db.Decimal(10, 2)
  reason          String
  createdAt       DateTime         @default(now())

  @@index([orderId])
  @@index([inventoryItemId, createdAt])
}

// ─── Purchases ledger ────────────────────────────────────────────────────────

model PosPurchase {
  id               String   @id @default(cuid())
  remark           String
  amount           Decimal  @db.Decimal(10, 2)
  purchasedAt      DateTime @default(now())
  createdByAdminId String?
  createdBy        User?    @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([purchasedAt])
}

model SystemSettings {
  id                          String   @id @default(cuid())
  maxOrdersPerDay             Int      @default(15)
  orderingEnabled             Boolean  @default(true)
  minimumDeliveryAmount       Decimal? @db.Decimal(10, 2)
  /// Admin storefront display name (sidebar, optional public use).
  companyName                 String?
  /// URL from POST /uploads/image (admin).
  companyLogoUrl              String?
  /// Payment transfer QR shown at checkout (uploaded image / SVG URL).
  paymentQrUrl                String?
  // ─── Single-outlet config (fulfillment header, fees, tax, ETA) ──────────────
  /// Public outlet name shown in the pickup block.
  outletName                  String?
  /// Pickup address shown in the fulfillment header.
  outletAddress               String?
  /// Opening hours as JSON (e.g. { "mon": "11:00-21:00", ... }).
  outletHours                 Json?
  /// Prep-time minutes powering "Delivery/Pickup in N min" ETA.
  prepTimeMinutes             Int?
  /// Flat delivery fee (delivery orders only). Null = free / not charged.
  deliveryFee                 Decimal? @db.Decimal(10, 2)
  /// Optional flat processing fee applied to every order.
  processingFee               Decimal? @db.Decimal(10, 2)
  /// SST rate percent included in the total (default 6%).
  taxRatePercent              Decimal  @default(6) @db.Decimal(5, 2)
  /// Informational delivery-radius note (no geocoding/enforcement).
  deliveryRadiusNote          String?
  // ─── Bakar & Roast catering booking rules ───────────────────────────────────
  /// Earliest bookable date = today + this many days (Malaysia local).
  cateringMinNoticeDays       Int      @default(7)
  /// Latest bookable date = today + this many months.
  cateringBookingWindowMonths Int      @default(6)
  /// A PENDING request holds its date this many days before it expires.
  cateringHoldExpiryDays      Int      @default(3)
  /// Customers may cancel until this many days before the event.
  cateringCancelCutoffDays    Int      @default(3)
  /// Owner inbox for new-request and customer-cancelled emails (Resend).
  cateringNotifyEmail         String?
  /// Default bookings (sets) taken per day. A CateringDay row can override one date.
  cateringDailySets           Int      @default(5)
  /// Whether the daily limit applies. Off = a day takes any number of bookings, unless that day
  /// has its own number (CateringDay.capacity) or is closed.
  cateringDailyLimitOn        Boolean  @default(true)
  /// Shown on the customer's booking page so they can pay.
  cateringBankName            String?
  cateringBankAccountName     String?
  cateringBankAccountNumber   String?
  /// DuitNow / bank QR image URL.
  cateringPaymentQrUrl        String?
  /// Delivery hours customers can pick from, "HH:mm" Malaysia time. A CateringDay can override.
  cateringDeliveryStart       String   @default("10:00")
  cateringDeliveryEnd         String   @default("21:00")
  // ─── Bakar & Roast shop (/order) availability rules ─────────────────────────
  /// Earliest fulfilment date (official open; nothing is cooked before this). YYYY-MM-DD.
  shopEarliestDate            String   @default("2026-12-14")
  /// Orders are accepted only from this date on (pre-orders open). Null = open now.
  shopOrdersOpenDate          String?
  /// Buffer: a customer cannot order within this many days of the fulfilment date.
  shopMinNoticeDays           Int      @default(2)
  /// Latest fulfilment date = today + this many days.
  shopWindowDays              Int      @default(60)
  /// Default serving window, on the hour "HH:00" Malaysia time. A ShopDay can override.
  shopServeStart              String   @default("12:00")
  shopServeEnd                String   @default("20:00")
  /// Length of one time slot in minutes (30, 60, 90 or 120). Slots run back to back from the
  /// serving start; a last piece shorter than a slot is not offered.
  shopSlotMinutes             Int      @default(60)
  /// Business WhatsApp number for the Bakar & Roast site, digits with country code
  /// ("601175126433"). Null = the built-in default. Bank and QR for /order payments reuse the
  /// cateringBank* and cateringPaymentQrUrl columns above (one set of details for the brand).
  shopWhatsappNumber          String?
  updatedAt                   DateTime @updatedAt
}

// ─── Bakar & Roast catering ───────────────────────────────────────────────────

enum CateringBookingStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum CateringPriceUnit {
  PER_SET
  PER_PAX
}

/// What the customer chose to pay first.
enum CateringPaymentChoice {
  DEPOSIT
  FULL
}

model CateringPackage {
  id          String            @id @default(cuid())
  name        String
  /// Price per set or per pax (priceUnit). Null = quoted by the owner after the request.
  price       Decimal?          @db.Decimal(10, 2)
  priceUnit   CateringPriceUnit @default(PER_SET)
  tagline     String?
  description String
  includes    String[]
  imageUrl    String?
  minGuests   Int               @default(10)
  maxGuests   Int?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  bookings    CateringBooking[]
}

model CateringBooking {
  id            String                @id @default(cuid())
  /// Human reference shown to customer and owner, e.g. BR-7K2M9Q.
  reference     String                @unique
  /// Unguessable token for the public status page and cancel link.
  accessToken   String                @unique
  status        CateringBookingStatus @default(PENDING)
  /// Malaysia-local calendar date of the event. Never a timestamp.
  eventDate     DateTime              @db.Date
  /// Delivery time as "HH:mm", Malaysia local.
  serviceTime   String
  packageId     String
  package       CateringPackage       @relation(fields: [packageId], references: [id])
  /// Snapshot so later package edits do not rewrite history.
  packageName   String
  guests        Int
  /// No longer asked for (delivery bookings). Kept for older bookings.
  occasion      String?
  customerName  String
  customerPhone String
  customerEmail String
  /// Delivery address.
  eventAddress  String
  dietaryNotes  String?
  notes         String?
  quoteAmount   Decimal?              @db.Decimal(10, 2)
  /// Amount asked first: half (DEPOSIT) or the whole total (FULL).
  depositAmount Decimal?              @db.Decimal(10, 2)
  paymentChoice CateringPaymentChoice @default(DEPOSIT)
  depositPaidAt DateTime?
  balancePaidAt DateTime?
  adminNotes    String?
  declineReason String?
  holdExpiresAt DateTime?
  decidedAt     DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  /// Set when the customer was signed in while booking. Guest bookings stay null.
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  receipts      CateringReceipt[]

  @@index([status, eventDate])
  @@index([createdAt])
  @@index([packageId])
  @@index([customerEmail, status])
  @@index([customerPhone, status])
  @@index([userId])
}

/// One row per date the owner changed: closed, or a different number of sets than the
/// default. Also the row lock that stops two customers taking the last set at once.
model CateringDay {
  date          DateTime @id @db.Date
  closed        Boolean  @default(false)
  /// Sets (bookings) taken this day. Null = SystemSettings.cateringDailySets.
  capacity      Int?
  /// Why it is closed, shown to the owner only.
  note          String?
  /// This day's delivery hours, "HH:mm". Null = the defaults in SystemSettings.
  deliveryStart String?
  deliveryEnd   String?
  updatedAt     DateTime @updatedAt
}

/// A payment receipt the customer uploaded from their booking page.
model CateringReceipt {
  id        String          @id @default(cuid())
  bookingId String
  booking   CateringBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String?
  createdAt DateTime        @default(now())

  @@index([bookingId])
}

model CateringGalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model CateringTestimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Bakar & Roast shop orders (the public /order flow) ───────────────────────

enum ShopFulfilmentType {
  PICKUP
  DELIVERY
}

/// Payment chosen at checkout: half now (DEPOSIT) or the whole total (FULL).
enum ShopPaymentChoice {
  DEPOSIT
  FULL
}

enum ShopOrderStatus {
  /// Saved, waiting for the customer to pay and upload proof.
  AWAITING_PAYMENT
  /// Owner has seen a receipt and confirmed the deposit (half) payment.
  DEPOSIT_PAID
  /// Owner has confirmed the order is paid in full.
  PAID
  CANCELLED
}

/// A customer order from the Bakar & Roast /order flow. It is saved before any payment
/// detail is shown and served from its accessToken URL, so a refresh, a tab eviction or a
/// return from the banking app never loses it. Packages and prices are server-side config
/// (the ShopPackage table); each item snapshots name and price so later edits never rewrite history.
model ShopOrder {
  id             String             @id @default(cuid())
  /// Human reference read over the phone, e.g. BR-7K2M9Q.
  reference      String             @unique
  /// Unguessable token: the only key to the public order page and receipt upload.
  accessToken    String             @unique
  /// Client-generated key so a double-tap or a retry returns the same order, not a duplicate.
  idempotencyKey String?            @unique
  status         ShopOrderStatus    @default(AWAITING_PAYMENT)
  type           ShopFulfilmentType
  /// Delivery address (all null for pickup). Country is always Malaysia.
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postcode       String?
  deliveryNotes  String?
  /// Malaysia-local fulfilment date. Never a timestamp.
  fulfilmentDate DateTime           @db.Date
  /// Chosen time window as "HH:mm-HH:mm", e.g. 12:00-13:00.
  timeSlot       String
  customerName   String
  customerPhone  String
  customerEmail  String?
  /// The signed-in customer who placed it. Null for a guest order.
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Money snapshot. No delivery fee line for now (arranged over WhatsApp), so total == subtotal.
  subtotal       Decimal            @db.Decimal(10, 2)
  total          Decimal            @db.Decimal(10, 2)
  paymentChoice  ShopPaymentChoice  @default(DEPOSIT)
  /// Amount asked now: half of total (DEPOSIT) or the whole total (FULL).
  amountDue      Decimal            @db.Decimal(10, 2)
  depositPaidAt  DateTime?
  fullyPaidAt    DateTime?
  /// When the customer tapped "I've made the payment" (paid by transfer, maybe sent the receipt on
  /// WhatsApp). A claim only: the owner still confirms the money before the order proceeds.
  customerPaidAt DateTime?
  adminNotes     String?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          ShopOrderItem[]
  receipts       ShopReceipt[]

  @@index([status, createdAt])
  @@index([fulfilmentDate])
  @@index([customerPhone])
  @@index([userId])
}

model ShopOrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Package key (A/B/C) at order time.
  packageKey  String
  /// Snapshot so later price or name edits never rewrite past orders.
  packageName String
  unitPrice   Decimal   @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
}

/// A package sold on the Bakar & Roast /order menu, edited by the owner in the admin
/// (/admin/shop-packages). Order items copy the name and price and hold the id as a plain
/// string (no relation), so a package can be edited or deleted without touching past orders.
model ShopPackage {
  id          String   @id @default(cuid())
  name        String
  tagline     String   @default("")
  description String   @default("")
  /// "What's included" lines, in order.
  includes    String[]
  /// Photo URLs, cover first.
  images      String[]
  price       Decimal  @db.Decimal(10, 2)
  /// False hides it from the menu and refuses new orders for it.
  active      Boolean  @default(true)
  /// Menu order, lowest first.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

/// A payment receipt the customer uploaded from their order page.
model ShopReceipt {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String?
  createdAt DateTime  @default(now())

  @@index([orderId])
}

/// One row per date the owner changed for the shop: closed, or serving hours different from
/// the SystemSettings default. Mirrors CateringDay, but the shop has no capacity, so there is
/// no lock row — only owner-set overrides live here.
model ShopDay {
  date       DateTime @id @db.Date
  closed     Boolean  @default(false)
  /// Why it is closed, shown to the owner only.
  note       String?
  /// This day's serving window, on the hour "HH:00". Null = the default in SystemSettings.
  serveStart String?
  serveEnd   String?
  updatedAt  DateTime @updatedAt
}
