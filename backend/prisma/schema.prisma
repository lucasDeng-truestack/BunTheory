generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Live menu (storefront reads this directly; admin edits in place).
model Menu {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?
  price        Decimal           @db.Decimal(10, 2)
  image        String?
  isFavorite   Boolean           @default(false)
  available    Boolean           @default(true)
  /// Max total quantity that can be sold (all-time). Null = unlimited.
  maxQuantity  Int?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
}

model MenuOptionGroup {
  id          String       @id @default(cuid())
  menuId      String
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  sortOrder   Int          @default(0)
  name        String
  required    Boolean      @default(false)
  multiSelect Boolean      @default(false)
  options     MenuOption[]
}

model MenuOption {
  id         String          @id @default(cuid())
  groupId    String
  group      MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)
  label      String
  priceDelta Decimal         @default(0) @db.Decimal(10, 2)
}

model Order {
  id           String       @id @default(cuid())
  slugId       String       @unique
  customerName String
  phone        String
  type         OrderType
  /// Full street address when type is DELIVERY.
  deliveryAddress String?
  /// Gate, unit, landmarks (optional) when type is DELIVERY.
  deliveryNotes   String?
  status       OrderStatus  @default(RECEIVED)
  batchId      String?
  batch        OrderBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  /// Checkout selection: pay at pickup vs online transfer + receipt.
  paymentChoice         PaymentChoice         @default(PAY_LATER)
  /// Set when PAY_NOW: URL to uploaded payment proof (same host as /uploads).
  paymentReceiptUrl     String?
  orderItems   OrderItem[]
  appFeedbacks AppFeedback[]
}

/// Optional post-checkout remarks about the storefront experience (linked to order when provided).
model AppFeedback {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
}

/// How the customer intends to pay (checkout modal).
enum PaymentChoice {
  PAY_LATER
  PAY_NOW
}

enum OrderBatchStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A time window when customers may order (live menu applies; capacity is per batch).
model OrderBatch {
  id              String           @id @default(cuid())
  label           String?
  fulfillmentDate DateTime         @db.Date
  opensAt         DateTime
  closesAt        DateTime
  maxItems        Int
  status          OrderBatchStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity          Int
  menuId            String
  menu              Menu     @relation(fields: [menuId], references: [id])
  remarks           String?
  unitPrice         Decimal  @db.Decimal(10, 2)
  selectedOptions   Json?
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  /// POS / admin UI display name (e.g. \"Ahmad\") — falls back to email if empty.
  displayName  String?
  createdAt    DateTime @default(now())

  posOrders         PosOrder[] @relation("CreatedByAdmin")
  posOrdersPaidBy   PosOrder[] @relation("PaidByAdmin")
}

// ─── Weekend Grills POS ───────────────────────────────────────────────────────

enum PosServiceType {
  EAT_HERE
  TAKEAWAY
}

enum PosPaymentMethod {
  CASH
  QR
}

enum PosPaymentStatus {
  UNPAID
  PAID
  REFUNDED
  VOIDED
}

enum PosOrderStatus {
  PLACED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum InventoryUnit {
  GRAM
  KG
  ML
  LITER
  PIECE
  PACK
}

enum InventoryMovementType {
  PURCHASE
  SALE_USAGE
  WASTE
  ADJUSTMENT
}

enum PosMenuItemKind {
  MAIN_MEAL
  SIDE
  DRINK_ADDON
}

model PosCategory {
  id               String               @id @default(cuid())
  name             String
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  items            PosMenuItem[]
  sectionHeaders   PosMenuSectionHeader[]
}

/// Staff-defined subsection headers under each menu pillar category (McDonald\'s-style).
model PosMenuSectionHeader {
  id          String           @id @default(cuid())
  categoryId  String
  category    PosCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?          /// Optional hint for staff / kitchen.
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       PosMenuItem[]

  @@index([categoryId, sortOrder])
}

model PosMenuItem {
  id               String               @id @default(cuid())
  categoryId       String?
  category         PosCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind             PosMenuItemKind      @default(MAIN_MEAL)
  sectionHeaderId  String?
  sectionHeader    PosMenuSectionHeader? @relation(fields: [sectionHeaderId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  price            Decimal              @db.Decimal(10, 2)
  image            String?
  available        Boolean              @default(true)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  orderItems         PosOrderItem[]
  recipeIngredients  PosRecipeIngredient[]
}

model PosOrder {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerName    String
  serviceType     PosServiceType
  status          PosOrderStatus   @default(PLACED)
  paymentMethod   PosPaymentMethod
  paymentStatus   PosPaymentStatus @default(UNPAID)
  subtotal        Decimal          @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  notes           String?

  createdByAdminId String?
  createdBy        Admin?  @relation("CreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  paidByAdminId String?
  paidBy        Admin?  @relation("PaidByAdmin", fields: [paidByAdminId], references: [id], onDelete: SetNull)

  paidAt      DateTime?
  startedAt   DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems       PosOrderItem[]
  stockMovements   InventoryStockMovement[]

  @@index([status])
  @@index([createdAt])
}

model PosOrderItem {
  id         String      @id @default(cuid())
  orderId    String
  order      PosOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   PosMenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal     @db.Decimal(10, 2)
  remarks    String?
}

// ─── Inventory ─────────────────────────────────────────────────────────────

model InventoryItem {
  id                String        @id @default(cuid())
  name              String
  unit              InventoryUnit
  lowStockThreshold Decimal?      @db.Decimal(10, 3)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  purchases         InventoryPurchase[]
  stockMovements    InventoryStockMovement[]
  recipeIngredients PosRecipeIngredient[]
}

model InventoryPurchase {
  id           String        @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity     Decimal       @db.Decimal(10, 3)
  totalCost    Decimal       @db.Decimal(10, 2)
  supplierName String?
  notes        String?
  purchasedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([itemId])
  @@index([purchasedAt])
}

model InventoryStockMovement {
  id             String                @id @default(cuid())
  itemId         String
  item           InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           InventoryMovementType
  quantityChange Decimal               @db.Decimal(10, 3)
  unitCost       Decimal?              @db.Decimal(10, 4)
  referenceOrderId String?
  referenceOrder   PosOrder?           @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime              @default(now())

  @@index([itemId])
  @@index([type])
  @@index([referenceOrderId])
}

model PosRecipeIngredient {
  id            String        @id @default(cuid())
  menuItemId    String
  menuItem      PosMenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityUsed  Decimal       @db.Decimal(10, 3)
  unit          InventoryUnit

  @@unique([menuItemId, inventoryItemId])
}

model SystemSettings {
  id                      String   @id @default(cuid())
  maxOrdersPerDay         Int      @default(15)
  orderingEnabled         Boolean  @default(true)
  minimumDeliveryAmount   Decimal? @db.Decimal(10, 2)
  /// Admin storefront display name (sidebar, optional public use).
  companyName             String?
  /// URL from POST /uploads/image (admin).
  companyLogoUrl          String?
  /// Payment transfer QR shown at checkout (uploaded image / SVG URL).
  paymentQrUrl            String?
  /// WhatsApp number for admin new-order alerts (E.164 e.g. +60123456789). Overrides .env fallback.
  adminWhatsappNumber     String?
  updatedAt               DateTime @updatedAt
}
