DATABASE_URL="postgresql://user:password@localhost:5432/bun_theory?schema=public"
# Better Auth signing secret. Generate with `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=""
# Public URL of this API (Better Auth base URL).
BETTER_AUTH_URL="http://localhost:3101"
PORT=3101
# Frontend origins allowed by CORS (comma-separate multiple apps — e.g. customer site + POS on Vercel).
FRONTEND_URL="http://localhost:3000"
# Include every deployed browser origin: main + preview URLs, e.g.
# FRONTEND_URLS="https://bun-theory.vercel.app,https://weekend-grill.vercel.app,https://weekend-grill-git-main-xxx.vercel.app"
FRONTEND_URLS=""

# Storage (S3/R2 compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="bun-theory-uploads"
S3_REGION="auto"
# Base URL for stored files (local /uploads, or R2 public dev URL / custom domain when using R2)
PUBLIC_URL="http://localhost:3101/uploads"

# HMAC signing for POS e-receipt links (guests scan QR). Use a long random secret in production.
POS_RECEIPT_TOKEN_SECRET=""

# Resend email (Bakar & Roast catering). Leave RESEND_API_KEY empty to disable sending.
RESEND_API_KEY=""
EMAIL_FROM="Bakar & Roast <onboarding@resend.dev>"
# Bakar & Roast site origin, used for links in emails.
PUBLIC_SITE_URL="http://localhost:3200"
# Set to 1 in production behind a reverse proxy (Railway, Render, nginx) so the booking rate limit sees real client IPs.
# TRUST_PROXY=1
